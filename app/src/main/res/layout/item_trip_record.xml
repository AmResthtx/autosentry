<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_cluster_card"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <!-- Header: Title, Purpose Badge, Duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/trip_purpose_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEAVY TOWING"
                    android:textColor="#F59E0B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="#78350F"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/trip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trip #104: Mountain Pass Haul"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/trip_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aug 30, 2026 • 2:15 PM - 4:45 PM (2h 30m)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/trip_distance_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="148.5 mi"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#0C4A6E" />
    </LinearLayout>

    <!-- Key Metrics Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#090D16"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG MPG"
                android:textColor="#64748B"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/trip_mpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.2 MPG"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX BOOST"
                android:textColor="#64748B"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/trip_max_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23.4 PSI"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX EOT"
                android:textColor="#64748B"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/trip_max_eot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="204 °F"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANS TEMP"
                android:textColor="#64748B"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/trip_max_trans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="172 °F"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secondary Telemetry Row: Speed, Fuel Consumed, ICP/IPR, Health Alerts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/trip_speed_fuel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Speed: Avg 58 mph (Max 74) • Fuel: 10.4 gal"
            android:textColor="#CBD5E1"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/trip_health_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✓ 0 PID Out-of-Line Alerts"
            android:textColor="#4ADE80"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Notes & Route Info -->
    <TextView
        android:id="@+id/trip_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Route: Denver to Silverthorne with 12k lb horse trailer. Stable ICP (2,650 PSI max)."
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="4dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_view_telemetry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PID Telemetry Graph"
            android:textSize="10sp"
            android:backgroundTint="#334155"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_delete_trip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="10sp"
            android:backgroundTint="#7F1D1D"
            android:layout_marginStart="3dp" />
    </LinearLayout>

</LinearLayout>
