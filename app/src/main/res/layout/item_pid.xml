<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="#1E293B">

    <!-- Symbol / Glyph Display -->
    <TextView
        android:id="@+id/pid_item_symbol"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="⚡"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#0F172A"
        android:textColor="#38BDF8"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pid_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine RPM [RPM]"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pid_item_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBD Mode: 010C • Interval: 1s • PCM"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/pid_item_applicability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Matched to 7.3L PowerStroke (HEUI)"
            android:textColor="#4ADE80"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pid_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVE"
        android:textColor="#4ADE80"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#064E3B" />
</LinearLayout>
