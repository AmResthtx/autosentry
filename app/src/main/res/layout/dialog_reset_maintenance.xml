<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Service / Upgrade &amp; Reset Interval"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/dialog_service_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine Oil &amp; Filter (Motorcraft FL-1995)"
            android:textSize="13sp"
            android:textColor="#38BDF8"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <!-- Date Serviced / Installed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date Serviced / Installed:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/dialog_edit_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="YYYY-MM-DD"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:background="#1E293B"
                android:padding="10dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/dialog_btn_pick_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Date"
                android:textSize="11sp"
                android:backgroundTint="#0284C7"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odometer / Mileage at Service:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/dialog_edit_mileage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 164250"
            android:inputType="number"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Cost and Resale Value Added Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service / Parts Cost ($):"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/dialog_edit_cost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 118.50"
                    android:inputType="numberDecimal"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:background="#1E293B"
                    android:padding="10dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depreciation Offset ($):"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/dialog_edit_deprec_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 95.00"
                    android:inputType="numberDecimal"
                    android:textColor="#38BDF8"
                    android:textColorHint="#64748B"
                    android:background="#1E293B"
                    android:padding="10dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Part Brand / Spec #:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/dialog_edit_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Motorcraft FL-1995 / Shell Rotella T6"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service Facility / Mechanic / DIY:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/dialog_edit_shop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Ford Quick Lane / Self-Performed"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parts, Specs &amp; CarFax Notes:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/dialog_edit_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Replaced oil with 15 Qts Shell Rotella T6 5W-40 and FL-1995 filter"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="10dp"
            android:lines="2"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receipt / In-Shop Work Photo Proof:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Photo Selection / Camera Preview Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="8dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/dialog_receipt_preview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_camera"
                android:background="#0F172A"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <Button
                    android:id="@+id/dialog_btn_choose_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload / Take Photo"
                    android:textSize="11sp"
                    android:backgroundTint="#0284C7" />

                <TextView
                    android:id="@+id/dialog_photo_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No receipt file attached yet"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
