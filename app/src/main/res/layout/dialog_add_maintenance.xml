<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edit_maint_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Service name (e.g., Oil change)" />

    <EditText
        android:id="@+id/edit_interval_km"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Interval (km, 0 to skip)"
        android:inputType="number" />

    <EditText
        android:id="@+id/edit_interval_months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Interval (months, 0 to skip)"
        android:inputType="number" />

    <EditText
        android:id="@+id/edit_maint_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes (optional)" />

</LinearLayout>
