<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_cluster_card"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <!-- 80% Service Planning Alert Banner -->
    <LinearLayout
        android:id="@+id/banner_80pct_wear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#78350F"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_80pct_alert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ 80% WEAR REACHED - SERVICE PLANNING REQUIRED"
            android:textColor="#FDE68A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_80pct_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="84% Consumed"
            android:textColor="#FEF3C7"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#92400E" />
    </LinearLayout>

    <!-- Header: Title, Category & Status Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/item_maint_symbol"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="🛢️"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/item_type_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ UPGRADE"
                    android:textColor="#38BDF8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="#0C4A6E"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/item_maint_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KC300x Stage 1 Turbo Upgrade"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_brand_warranty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brand: KC Turbos • Warranty: 3-Year / 36k Mi • Category: ENGINE"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/item_maint_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INSTALLED"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="#0C4A6E" />
    </LinearLayout>

    <!-- Wear Progress Bar & Life Status -->
    <LinearLayout
        android:id="@+id/wear_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_wear_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Service Life Consumed: 82%"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/item_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="900 mi remaining"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/item_wear_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="82"
            android:max="100"
            android:progressTint="#F59E0B"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Details Row: Date Serviced / Installed & Next Due / Odometer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_label_date_serviced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Serviced / Installed"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/item_last_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="158,000 mi (May 14, 2026)"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_label_next_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Service Due / Status"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/item_next_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permanent Performance Asset"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Depreciation Value & Cost Highlight Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#090D16"
        android:padding="6dp"
        android:layout_marginTop="6dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/item_cost_spent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Installed Cost: $1,450.00"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/item_deprec_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Resale Protection: +$1,100.00"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Receipt Preview & Shop Container -->
    <LinearLayout
        android:id="@+id/receipt_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#090D16"
        android:padding="8dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/item_receipt_thumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="#1E293B"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/item_shop_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Facility: PowerStroke Pro • Work Verified"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard specifications and parts used"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:maxLines="2" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_view_receipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Details"
            android:textSize="10sp"
            android:backgroundTint="#334155" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_item_ai_deals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="⚡ AI Find Best Deals"
            android:textSize="11sp"
            android:backgroundTint="#0284C7"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_item_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Log / Reset"
            android:textSize="11sp"
            android:backgroundTint="#22C55E"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_item_upload_photo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receipt"
            android:textSize="11sp"
            android:backgroundTint="#334155" />
    </LinearLayout>

</LinearLayout>
